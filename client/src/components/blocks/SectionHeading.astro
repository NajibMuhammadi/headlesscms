---
import type { HeadingSectionProps } from "../../utils/types";


interface Props {
  data: HeadingSectionProps;
}

const {
  data: { heading, subHeading, anchorLink },
} = Astro.props;

---

<section id={anchorLink}>
    <div class="flex items-center justify-between mb-8">
      <div>
        <span class="text-green-600 font-bold">{subHeading}</span>
        <h2 class="text-2xl font-bold">{heading}</h2>
      </div>
      <a href="/articles/" class="text-purple-500 hover:text-purple-400 text-sm flex items-center gap-2">
        View alls 
      </a>
    </div>
</section>