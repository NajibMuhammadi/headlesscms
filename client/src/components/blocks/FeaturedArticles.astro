---
import type { FeaturedArticlesProps } from "../../utils/types";
import { formatDate } from "../../utils/index";
import StrapiImage from "../StrapiImage.astro";
import { Eye, Cpu, BrainCircuit } from 'lucide-static';

interface Props {
  data: FeaturedArticlesProps;
}

const {
  data: { articles },
} = Astro.props;

// Mappa Strapi-fältnamn till riktiga ikonkomponenter
const iconMap = {
  GenAI: BrainCircuit,
  FutureTech: Cpu,
  AIResearch: Eye,
};
---

<section class="bg-gray-50">
  <div class="container mx-auto">
    <div class="grid md:grid-cols-3 gap-6">
      {
        articles.map((article) => {
          const Icon = iconMap[article.category] || null;
          return (
                <article class="bg-white rounded shadow p-6 hover:shadow-lg transition">
                    <a href={`/blog/${article.slug}`} key={article.slug}>
                  <StrapiImage
                    src={article.featuredImage.url}
                    alt={article.featuredImage.alternativeText || article.title}
                    height={300}
                    width={600}
                    class="mb-4 rounded"
                  />
                  <div class="flex items-center text-sm text-green-600 font-bold mb-2 gap-2">
                    {Icon && <Icon class="h-5 w-5" />}
                    {article.category}
                  </div>
                  <h3 class="text-xl font-semibold mb-2">{article.title}</h3>
                  <p class="text-gray-500 text-sm mb-4">{article.description}</p>
                  <div class="flex items-center justify-between text-gray-400 text-sm">
                    <span>{formatDate(article.publishedAt)}</span>
                    <a href={`/blog/${article.slug}`} class="text-green-600 hover:text-green-700 font-bold">Read more</a>
                  </div>
                </a>
                </article>
          );
        })
      }
    </div>
  </div>
</section>
